# .env.pc — secretos para la INGESTA EN EL PC. Copia este fichero a «.env.pc» y rellénalo (o, más fácil,
# copia directamente el .env del NAS a «.env.pc»). NO se sube a git (está en .gitignore).
#
# docker-compose.pc.yml lo monta en /app/.env → dotenv lo lee dentro del contenedor, igual que en el NAS.
# Las rutas (PATH_*) y el watcher los fija el propio compose, así que aquí SOLO hacen falta los secretos.
#
# Es la MISMA base de datos que el NAS: Atlas es la fuente de la verdad compartida (el PC cataloga, el NAS
# sirve; ambos ven lo mismo).

# --- Base de datos (Atlas, en la nube) ---
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=biblioteca

# --- Panel / autenticación (misma clave que el NAS para que los tokens sean compatibles) ---
ADMIN_PWD=tu-clave-admin
GUEST_PWD=guest
TZ=Europe/Madrid

# --- Claves de IA y APIs (las MISMAS que el NAS: la ingesta las necesita para visión/CDU) ---
# Copia aquí exactamente las que tengas en el .env del NAS:
#   GEMINI_API_KEY=...            (o GEMINI_API_FREE_KEY_1/2/…, GEMINI_API_KEY_PAID)
#   GROQ_API_KEY_1=...            OPENROUTER_API_KEY_1=...
#   GOOGLE_BOOKS_API_KEY=...      EUROPEANA_API_KEY=...
GEMINI_API_KEY=
GOOGLE_BOOKS_API_KEY=

# NOTA: NO pongas DESACTIVAR_VIGILANTE aquí — el PC debe catalogar. (Aunque lo pusieras, el compose lo
# fuerza a 0). En el NAS, en cambio, DESACTIVAR_VIGILANTE=1 apaga su ingesta.
